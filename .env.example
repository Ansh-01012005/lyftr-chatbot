# For local offline demo, use LLM_MODE=mock and any two placeholder keys.
# For live answers, set LLM_MODE=litellm and add two valid provider keys.
LLM_MODE=litellm
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000
