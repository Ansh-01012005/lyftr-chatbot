# For local offline demo, use LLM_MODE=mock and any placeholder key.
# For live answers, set LLM_MODE=litellm and add one valid OpenRouter key.
LLM_MODE=litellm
LLM_API_KEYS=replace-with-openrouter-key
LLM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODELS=openrouter/baidu/ernie-5.5-flash-preview:free,openrouter/google/gemma-4-31b-it:free,openrouter/inclusionai/ling-3.2-flash:free
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ansh-01012005.github.io
ENABLE_FAILURE_SIMULATION=false
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000
